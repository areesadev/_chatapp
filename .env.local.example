# Painel do projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://wjlxsmzvsxvthjxebdht.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wiQqQ21A15NDhFEQ8vDJSw_dnEy9ntg

# Chave secreta — NUNCA exponha no browser nem suba para o repositório.
# Usada só em rotas de servidor (convite de usuário, operações de admin).
SUPABASE_SECRET_KEY=

# ─── Provedores de IA ──────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Embeddings da base de conhecimento (Fase 2) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Aplicação ─────────────────────────────────────────────────────────────────
# URL pública, usada no redirect do magic link. Em produção: https://cerebro.areesa.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/indexar, que recolhe documentos que ficaram na fila.
# A Vercel envia esse valor automaticamente nos cron jobs. Sem ele, a rota
# fica desligada (503) em vez de aberta. Gere com: openssl rand -hex 32
CRON_SECRET=
